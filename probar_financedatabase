# -*- coding: utf-8 -*-
"""
Script de prueba: financedatabase con activos de IOL

Instalacion previa:
    pip install financedatabase yfinance

Ejecutar:
    python probar_financedatabase.py
"""

import sys
import financedatabase as fd
import yfinance as yf
import pandas as pd

# Fix Windows cp1252: forzar UTF-8 en stdout
if sys.platform == "win32":
    import io
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")

pd.set_option("display.max_columns", 10)
pd.set_option("display.width", 120)

# ──────────────────────────────────────────────────────────────────────────────
# TEST 1: Busqueda por nombre natural
# ──────────────────────────────────────────────────────────────────────────────
print("=" * 70)
print(" TEST 1 - Busqueda por nombre natural")
print("=" * 70)

equities = fd.Equities()

BUSQUEDAS = [
    "Pampa Energia",
    "YPF",
    "Grupo Financiero Galicia",
    "Loma Negra",
    "Ternium Argentina",
    "Banco Macro",
    "Supervielle",
    "MercadoLibre",
    "Globant",
]

for nombre in BUSQUEDAS:
    try:
        resultado = equities.search(name=nombre)
        if resultado.empty:
            print(f"[FAIL] '{nombre}' -> sin resultados")
        else:
            cols = [c for c in ["longname", "exchange", "country", "sector"] if c in resultado.columns]
            print(f"[OK]   '{nombre}' -> {len(resultado)} resultado(s)")
            print(resultado[cols].head(3).to_string())
    except Exception as e:
        print(f"[ERR]  '{nombre}' -> error: {e}")
    print()

# ──────────────────────────────────────────────────────────────────────────────
# TEST 2: Activos argentinos en BCBA
# ──────────────────────────────────────────────────────────────────────────────
print("=" * 70)
print(" TEST 2 - Activos argentinos (exchange BUE / country Argentina)")
print("=" * 70)

try:
    argentinos = equities.search(exchange="BUE")
    if argentinos.empty:
        argentinos = equities.search(country="Argentina")
    print(f"Total activos argentinos encontrados: {len(argentinos)}")
    if not argentinos.empty:
        cols = [c for c in ["longname", "exchange", "sector"] if c in argentinos.columns]
        print(argentinos[cols].head(20).to_string())
except Exception as e:
    print(f"[ERR] {e}")

print()

# ──────────────────────────────────────────────────────────────────────────────
# TEST 3: Validacion cruzada con yfinance
# ──────────────────────────────────────────────────────────────────────────────
print("=" * 70)
print(" TEST 3 - Validacion con yfinance (precios reales)")
print("=" * 70)

TICKERS_IOL = {
    "GGAL.BA": "Grupo Financiero Galicia",
    "YPFD.BA": "YPF S.A.",
    "PAMP.BA": "Pampa Energia",
    "BMA.BA":  "Banco Macro",
    "TXAR.BA": "Ternium Argentina",
    "LOMA.BA": "Loma Negra",
    "SUPV.BA": "Supervielle",
    "SPY":     "ETF S&P 500",
    "QQQ":     "ETF Nasdaq",
    "AAPL":    "Apple",
    "GOOGL":   "Alphabet",
    "MELI":    "MercadoLibre",
    "GLOB":    "Globant",
    "AL30":    "Bono AL30 (esperamos fallo)",
    "GD30":    "Bono GD30 (esperamos fallo)",
}

ok = 0
fail = 0
for ticker, nombre in TICKERS_IOL.items():
    try:
        hist = yf.Ticker(ticker).history(period="5d")
        if hist.empty:
            print(f"[WARN] {ticker:10s} ({nombre}) -> sin datos en yfinance")
            fail += 1
        else:
            precio = hist["Close"].iloc[-1]
            print(f"[OK]   {ticker:10s} ({nombre}) -> ultimo precio: {precio:.2f}")
            ok += 1
    except Exception as e:
        print(f"[ERR]  {ticker:10s} ({nombre}) -> {e}")
        fail += 1

print(f"\nResumen yfinance: {ok} con datos, {fail} sin datos o error")
print()

# ──────────────────────────────────────────────────────────────────────────────
# TEST 4: Mapeabilidad nombre -> ticker
# ──────────────────────────────────────────────────────────────────────────────
print("=" * 70)
print(" TEST 4 - Mapeo nombre -> ticker (conclusion)")
print("=" * 70)

MAPEOS_ESPERADOS = [
    ("Pampa Energia",   "PAMP"),
    ("YPF",             "YPFD"),
    ("Galicia",         "GGAL"),
    ("MercadoLibre",    "MELI"),
    ("Google",          "GOOGL"),
]

for nombre, ticker_esperado in MAPEOS_ESPERADOS:
    try:
        resultado = equities.search(name=nombre)
        tickers_encontrados = list(resultado.index) if not resultado.empty else []
        match = any(
            ticker_esperado in t or t.startswith(ticker_esperado)
            for t in tickers_encontrados
        )
        estado = "[OK]  " if match else "[FAIL]"
        print(f"{estado} '{nombre}' -> esperaba {ticker_esperado}, encontro: {tickers_encontrados[:5]}")
    except Exception as e:
        print(f"[ERR]  '{nombre}' -> {e}")

print()
print("=" * 70)
print(" Fin de pruebas.")
print("=" * 70)